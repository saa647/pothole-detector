# Firebase Realtime Database configuration
# Get these values from: Firebase Console -> Project Settings -> General -> Your apps
# Create a project at https://console.firebase.google.com if you don't have one yet.
# Copy this file to ".env" and fill in your real project values -- never commit ".env".

VITE_FIREBASE_API_KEY="your-real-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx"

# GEMINI_API_KEY: Only needed if you use Gemini AI features. Optional otherwise.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
